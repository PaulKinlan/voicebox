[Unit]
Description=Voicebox Software Factory local inbound issue poller
Documentation=https://github.com/PaulKinlan/voicebox/blob/main/docs/28-factory-review-adapter.md
After=network.target

[Service]
Type=oneshot
ExecStart=%h/voicebox/scripts/factory-issue-poller-runner.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
