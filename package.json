{
  "name": "voicebox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "voicebox \u2014 spoken turns become real files. Zero-dependency runtime; Vite is the dev server only.",
  "scripts": {
    "dev": "vite",
    "serve": "node server.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/*.mjs",
    "test:unit": "node --test $(node scripts/test-lanes.mjs --lane unit)",
    "test:live": "node --test --test-concurrency=1 $(node scripts/test-lanes.mjs --lane live)",
    "accept": "node tools/page-acceptance.mjs",
    "gate": "sh scripts/pre-push.sh",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "test:e1m0": "node --test tests/e1m0-core.test.mjs tests/e1m0-browser.test.mjs tests/n20-picked-root.test.mjs tests/n20-permission-denied.test.mjs tests/explorer.test.mjs tests/shared-log.test.mjs tests/two-agents.test.mjs tests/root-seam.test.mjs tests/one-root.test.mjs",
    "test:one-root": "node --test tests/root-seam.test.mjs tests/one-root.test.mjs",
    "test:shared-log": "node --test tests/shared-log.test.mjs tests/two-agents.test.mjs",
    "build:wasm": "node tools/build-wasm.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:write": "node scripts/docs-check.mjs --write"
  },
  "devDependencies": {
    "vite": "^7.1.7",
    "wabt": "^1.0.39"
  }
}