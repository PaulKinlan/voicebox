#!/usr/bin/env sh
# .githooks/pre-push — Tracked git pre-push hook for voicebox (voicebox-beads-99l)
# Composes beads git hook integration with repo-owned quality gate.

# Fast path: detect if push is exclusively branch/ref deletions or Dolt database sync (refs/dolt/*)
has_non_delete=0
has_code_ref=0
while read -r local_ref local_oid remote_ref remote_oid; do
  # The gate needs ALL destination refs, and this loop consumes stdin: hand them
  # over rather than breaking after the first line or letting the check read an empty pipe (voicebox-beads-85w).
  # The newline is a LITERAL inside the quotes: `$'\n'` is a bash-ism, and under dash
  # (Linux /bin/sh) it appends the three literal characters `$\n` — the accumulated blob
  # then has no line separator at all, `while read` never runs its body, and the gate
  # sees "no destination" and runs the FULL suite on every branch push (found on an
  # exe.dev VM, voicebox-beads-q0a3; the embedded newline is POSIX-portable and behaves
  # identically under bash-as-sh).
  VOICEBOX_PUSH_DESTINATIONS="${VOICEBOX_PUSH_DESTINATIONS:-}${local_ref} ${local_oid} ${remote_ref} ${remote_oid}
"
  if [ -n "$local_oid" ] && [ "$local_oid" != "0000000000000000000000000000000000000000" ] && [ "$local_oid" != "(delete)" ]; then
    has_non_delete=1
    case "$remote_ref" in
      refs/dolt/*|refs/heads/__dolt_remote_info__) ;;
      *) has_code_ref=1 ;;
    esac
  fi
done

if [ "$has_non_delete" = 0 ] || [ "$has_code_ref" = 0 ]; then
  exit 0
fi

# 1. Run beads pre-push hook if installed and not already running
if [ -z "$BD_GIT_HOOK" ] && command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-60}
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run pre-push "$@" || true
  else
    bd hooks run pre-push "$@" || true
  fi
fi

# 2. The gate bounds each stage and names its timeout. An outer timer could
# kill the gate before it prints that diagnosis (or before its stages finish).
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
export VOICEBOX_PUSH_DESTINATIONS
exec sh "$REPO_ROOT/scripts/pre-push.sh" "$@"
